# Apache fallback only. GitHub Pages ignores .htaccess.
# Source of legacy routes: config/url-redirects.json.
RewriteEngine On
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Resolve legacy URLs directly before general URL normalization.
RewriteRule ^bijeenkomsten(?:\.html)?/?$ /zakelijk [R=301,L,NE]
RewriteRule ^zalen(?:\.html)?/?$ /zakelijk [R=301,L,NE]
RewriteRule ^hotelkamers(?:\.html)?/?$ /hotel/ [R=301,L,NE]
RewriteRule ^camping(?:\.html)?/?$ /kamperen [R=301,L,NE]
RewriteRule ^verhuur(?:\.html)?/?$ /accommodaties/ [R=301,L,NE]
RewriteRule ^restaurant(?:\.html)?/?$ https://www.zeeuwsverlangen.nl/ [R=301,L,NE]
RewriteRule ^hotel/standaardkamer(?:\.html)?/?$ /hotel/duinkamer [R=301,L,NE]
RewriteRule ^en/hotel/standard\-room(?:\.html)?/?$ /en/hotel/dune-room [R=301,L,NE]
RewriteRule ^de/hotel/standardzimmer(?:\.html)?/?$ /de/hotel/duenenzimmer [R=301,L,NE]
RewriteRule ^en/kamperen(?:\.html)?/?$ /en/camping [R=301,L,NE]
RewriteRule ^en/contact\-en\-route(?:\.html)?/?$ /en/contact [R=301,L,NE]
RewriteRule ^en/impression(?:\.html)?/?$ /en/impressions [R=301,L,NE]
RewriteRule ^en/wifi(?:\.html)?/?$ /en/wifi-usage [R=301,L,NE]
RewriteRule ^de/hotel/standaard\-deluxe(?:\.html)?/?$ /de/hotel/standard-deluxe [R=301,L,NE]

# Redirect requested index.html URLs to their containing directory.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Existing flat HTML pages use extensionless canonical URLs.
RewriteCond %{THE_REQUEST} \s/+[^?\ ]+\.html(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Preserve true directories; serve .html only for existing flat pages.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
